{
  "name": "__SCOPE__/__APP__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {},
  "starter": {
    "runtime": "worker",
    "resultBoundaries": {
      "src/notes.ts:handleNotes": "HTTP ingress projects a handled Result into a platform Response."
    }
  },
  "scripts": {
    "dev": "vp dev --mode offline --host 127.0.0.1 --strictPort",
    "preview": "node preview.ts",
    "check": "vp check .",
