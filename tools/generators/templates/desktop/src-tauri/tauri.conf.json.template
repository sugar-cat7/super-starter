{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__PROJECT__",
  "version": "0.1.0",
  "identifier": "__IDENTIFIER__",
  "build": { "beforeDevCommand": "pnpm dev:renderer", "devUrl": "http://127.0.0.1:5174", "beforeBuildCommand": "pnpm build:renderer", "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "__PROJECT__", "width": 900, "height": 720 }],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": { "active": false, "targets": "all" }
}
