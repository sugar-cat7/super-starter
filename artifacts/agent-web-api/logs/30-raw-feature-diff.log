+test('a delayed initial count cannot replace a newer count after a create', async ({
+  page,
+  request,
+}) => {
+  const existing = notesSchema.parse(await (await request.get('/api/notes')).json());
+  for (const note of existing)
+    expect((await request.delete(`/api/notes/${note.id}`)).status()).toBe(204);
+  let release: (() => void) | undefined;
+  const waiting = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  let requests = 0;
+  let holdingInitial = true;
+  let completedInitial = 0;
+  // Both the page's independent count read and each successful list load refresh the count.
+  const expectedInitial = process.env.STARTER_BROWSER_MODE === 'production' ? 2 : 4;
+  await page.route('**/api/notes/count', async (route) => {
+    requests += 1;
+    if (holdingInitial) {
+      await waiting;
+      await route.fulfill({ json: { count: 0 } });
+      completedInitial += 1;
+    } else await route.continue();
+  });
+  try {
+    await page.goto('/');
+    const count = page.getByRole('status', { name: 'Note count' });
+    await expect(count).toHaveText('Counting notes…');
+    await expect.poll(() => requests).toBe(expectedInitial);
+    await page.getByLabel('New note').fill('Newer count');
+    holdingInitial = false;
+    await page.getByRole('button', { name: 'Add note', exact: true }).click();
+    await expect(count).toHaveText('1 note');
+    await expect.poll(() => requests).toBe(expectedInitial + 1);
+    release?.();
+    await expect.poll(() => completedInitial).toBe(expectedInitial);
+    await page.evaluate(
+      () =>
+        new Promise<void>((resolve) =>
+          requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+        ),
+    );
+    await expect(count).toHaveText('1 note');
+    await page.getByRole('button', { name: 'Delete Newer count' }).click();
+    await expect(count).toHaveText('0 notes');
+  } finally {
+    release?.();
+  }
+});
