 import { createFileRoute } from '@tanstack/react-router';
-import { NotesPanel } from '@independent-web/ui';
-import { browserNotes } from '../client/notes';
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { launch } from '@independent-web/contracts';
+import { NotesPanel, type NotesAdapter } from '@independent-web/ui';
+import { browserNotes, countNotes } from '../client/notes';
 
 export const Route = createFileRoute('/')({
-  component: () => <NotesPanel adapter={browserNotes} storage="Local D1 persistence" />,
+  component: NotesPage,
 });
+
+function NotesPage() {
+  const [count, setCount] = useState<number | null>(null);
+  const [countState, setCountState] = useState<'loading' | 'ready' | 'error'>('loading');
+  const current = useRef(true);
+  const generation = useRef(0);
+  const reportCountFailure = useCallback(() => {
+    if (current.current) {
+      setCount(null);
+      setCountState('error');
+    }
+  }, []);
+  const refreshCount = useCallback(() => {
+    const request = ++generation.current;
+    if (current.current) setCountState('loading');
+    launch(async () => {
+      const result = await countNotes();
+      if (!current.current || request !== generation.current) return;
+      if (result.ok) {
+        setCount(result.value);
+        setCountState('ready');
+      } else reportCountFailure();
+    }, reportCountFailure);
+  }, [reportCountFailure]);
+  useEffect(() => {
+    current.current = true;
+    refreshCount();
+    return () => {
+      current.current = false;
+      generation.current += 1;
+    };
+  }, [refreshCount]);
+  const adapter: NotesAdapter = useMemo<NotesAdapter>(
+    () => ({
+      ...browserNotes,
+      async list() {
+        const result = await browserNotes.list();
+        if (result.ok) refreshCount();
+        return result;
+      },
+      async add(input) {
+        const result = await browserNotes.add(input);
+        if (result.ok) refreshCount();
+        return result;
+      },
+      async remove(id) {
+        const result = await browserNotes.remove(id);
+        if (result.ok) refreshCount();
+        return result;
+      },
+    }),
+    [refreshCount],
+  );
+  return (
+    <>
+      <div className="mx-auto mb-3 max-w-2xl text-sm">
+        <output aria-label="Note count" aria-live="polite">
+          {countState === 'loading'
+            ? 'Counting notes…'
+            : countState === 'error'
+              ? 'Note count unavailable.'
+              : `${count} ${count === 1 ? 'note' : 'notes'}`}
+        </output>
+        {countState === 'error' && (
+          <button type="button" className="ml-3 underline" onClick={refreshCount}>
+            Retry count
+          </button>
+        )}
+      </div>
+      <NotesPanel adapter={adapter} storage="Local D1 persistence" />
+    </>
+  );
+}
