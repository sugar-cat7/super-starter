+test('count failure after a successful create preserves notes and supports retry', async ({
+  page,
+  request,
+}) => {
+  const existing = notesSchema.parse(await (await request.get('/api/notes')).json());
+  for (const note of existing)
+    expect((await request.delete(`/api/notes/${note.id}`)).status()).toBe(204);
+  await page.goto('/');
+  const count = page.getByRole('status', { name: 'Note count' });
+  await expect(count).toHaveText('0 notes');
+  await page.route('**/api/notes/count', (route) =>
+    route.fulfill({ status: 503, body: 'unavailable' }),
+  );
+  await page.getByLabel('New note').fill('Kept after count failure');
+  await page.getByRole('button', { name: 'Add note', exact: true }).click();
+  await expect(page.getByText('Kept after count failure', { exact: true })).toBeVisible();
+  await expect(count).toHaveText('Note count unavailable.');
+  await expect(page.getByRole('alert')).toHaveCount(0);
+  expect((await request.get('/api/notes/count')).status()).toBe(200);
+  await page.unroute('**/api/notes/count');
+  await page.getByRole('button', { name: 'Retry count' }).click();
+  await expect(count).toHaveText('1 note');
+  await page.route('**/api/notes', (route) => route.fulfill({ status: 503, body: 'unavailable' }));
+  await page.getByLabel('New note').fill('Failed create');
+  await page.getByRole('button', { name: 'Add note', exact: true }).click();
+  await expect(page.getByRole('alert')).toBeVisible();
+  await expect(count).toHaveText('1 note');
+  await expect(
+    page.getByRole('list', { name: 'Saved notes' }).getByText('Failed create', { exact: true }),
+  ).toHaveCount(0);
+  await expect(page.getByLabel('New note')).toHaveValue('Failed create');
+  await page.unroute('**/api/notes');
+  expect((await request.post('/api/notes', { data: { text: 'Found on retry' } })).status()).toBe(
+    201,
+  );
+  await page.getByRole('button', { name: 'Retry', exact: true }).click();
+  await expect(page.getByText('Found on retry', { exact: true })).toBeVisible();
+  await expect(count).toHaveText('2 notes');
+  await page.getByRole('button', { name: 'Delete Kept after count failure' }).click();
+  await expect(count).toHaveText('1 note');
+  await page.getByRole('button', { name: 'Delete Found on retry' }).click();
+  await expect(count).toHaveText('0 notes');
+});
