2026-10-12T19:39:19.4581759Z +              mode === 'rejection'
2026-10-12T19:39:19.4582117Z +                ? Promise.reject(new Error('PRIVATE-SQL-DO-NOT-EXPORT'))
2026-10-12T19:39:19.4582588Z +                : Promise.resolve({ success: false, error: 'PRIVATE-SQL-DO-NOT-EXPORT' }),
2026-10-12T19:39:19.4582977Z +          }),
2026-10-12T19:39:19.4583178Z +        } as unknown as D1Database;
2026-10-12T19:39:19.4583591Z +        const response = await handleNotes(new Request('https://sample.invalid/api/notes'), {
2026-10-12T19:39:19.4584020Z +          WRITE_MODE: 'allow',
2026-10-12T19:39:19.4584250Z +          NOTES: database,
2026-10-12T19:39:19.4584513Z +          OTEL_ENDPOINT: 'http://127.0.0.1:4318',
2026-10-12T19:39:19.4584799Z +        });
2026-10-12T19:39:19.4585144Z +        const body = (await response.json()) as { error: { code: string; diagnosticId: string } };
2026-10-12T19:39:19.4585733Z +        // Storage failure has an unknown outcome, rather than a proven retryable network failure.
2026-10-12T19:39:19.4586181Z +        expect(response.status).toBe(500);
2026-10-12T19:39:19.4586491Z +        expect(body.error.code).toBe('internal_error');
2026-10-12T19:39:19.4586866Z +        expect(body.error.diagnosticId).toMatch(/^[a-f0-9]{32}$/u);
2026-10-12T19:39:19.4587464Z +        expect(response.headers.get('x-diagnostic-id')).toBe(body.error.diagnosticId);
2026-10-12T19:39:19.4588134Z +        expect(response.headers.get('x-error-code')).toBe(body.error.code);
2026-10-12T19:39:19.4588528Z +        const wire = payloads.join('\n');
2026-10-12T19:39:19.4588821Z +        expect(wire).toContain('binding.d1.read');
