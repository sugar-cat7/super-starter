2026-10-12T19:39:19.4578727Z +    async (mode) => {
2026-10-12T19:39:19.4578955Z +      const payloads: string[] = [];
2026-10-12T19:39:19.4579285Z +      vi.stubGlobal('fetch', (_url: string, init: RequestInit) => {
2026-10-12T19:39:19.4579761Z +        if (typeof init.body !== 'string') throw new Error('Expected an OTLP JSON request');
2026-10-12T19:39:19.4580171Z +        payloads.push(init.body);
