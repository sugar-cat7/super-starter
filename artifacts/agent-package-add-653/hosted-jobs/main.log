2026-10-12T19:39:19.4592267Z +                spanId: string;
2026-10-12T19:39:19.4592513Z +                parentSpanId?: string;
2026-10-12T19:39:19.4592859Z +                attributes: { key: string; value: { stringValue: string } }[];
2026-10-12T19:39:19.4593201Z +              }[];
2026-10-12T19:39:19.4593386Z +            }[];
2026-10-12T19:39:19.4593568Z +          }[];
2026-10-12T19:39:19.4593747Z +        };
2026-10-12T19:39:19.4594003Z +        const spans = traces.resourceSpans.flatMap((resource) =>
2026-10-12T19:39:19.4594401Z +          resource.scopeSpans.flatMap((scope) => scope.spans),
