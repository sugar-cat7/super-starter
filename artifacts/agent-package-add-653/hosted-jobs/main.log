2026-10-12T19:39:19.4594906Z +        expect(spans).toHaveLength(2);
2026-10-12T19:39:19.4595253Z +        const http = spans.find((span) => span.name === 'http.request')!;
2026-10-12T19:39:19.4595858Z +        expect(spans.find((span) => span.name === 'binding.d1.read')!.parentSpanId).toBe(
2026-10-12T19:39:19.4596265Z +          http.spanId,
2026-10-12T19:39:19.4596463Z +        );
2026-10-12T19:39:19.4596655Z +        for (const span of spans)
2026-10-12T19:39:19.4596888Z +          expect(
2026-10-12T19:39:19.4597243Z +            span.attributes.find((attr) => attr.key === 'app.diagnostic.id')!.value.stringValue,
