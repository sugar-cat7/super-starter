@@ -0,0 +1,12 @@
+import { handleNotes } from './notes';
+
+export default {
+  fetch(request: Request, env: Env): Response | Promise<Response> {
+    if (request.method === 'GET' && new URL(request.url).pathname === '/status') {
+      const body = { ok: true, service: 'status' };
+      const headers = { 'cache-control': 'no-store' };
+      return Response.json(body, { headers });
+    }
+    return handleNotes(request, env);
+  },
+} satisfies ExportedHandler<Env>;
diff --git a/packages/status/src/notes.ts b/packages/status/src/notes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..488909b8a75fde21dd8a6cbdf6f8594c1a45e7e3
--- /dev/null
+++ b/packages/status/src/notes.ts
@@ -0,0 +1,267 @@
+import {
+  noteInput,
+  notesSchema,
+  decode,
+  capture,
+  captureSync,
+  Err,
+  Ok,
+  failure,
+  publicFailure,
+  errorStatus,
+  type Result,
+  type Note,
+} from '@independent-service/contracts';
+import { createTelemetry, type TraceCarrier, type OperationName } from '@independent-service/observability';
+import { z } from 'zod';
+
+export type SampleBindings = {
+  WRITE_MODE: string;
+  OTEL_SERVICE_NAME?: string;
+  OTEL_INSTANCE?: string;
+  OTEL_RUN_ID?: string;
+  OTEL_VERSION?: string;
+  OTEL_ENDPOINT?: string;
+  NOTES?: D1Database;
+  NOTE_CACHE?: KVNamespace;
+  NOTE_EXPORTS?: R2Bucket;
+};
+const volatileNotes = new Map<string, Note>();
+const extensionInput = z
+  .object({ key: z.string().regex(/^[a-z0-9-]{1,64}$/u), value: z.string().max(2000) })
+  .strict();
+
+export async function handleNotes(request: Request, env: SampleBindings): Promise<Response> {
+  const requestId = crypto.randomUUID();
+  const telemetry = createTelemetry({
+    service: env.OTEL_SERVICE_NAME ?? 'api',
+    instance: env.OTEL_INSTANCE ?? 'local',
+    runId: env.OTEL_RUN_ID ?? 'local',
+    version: env.OTEL_VERSION ?? 'development',
+    ...(env.OTEL_ENDPOINT ? { endpoint: env.OTEL_ENDPOINT } : {}),
+  });
+  const carrier: TraceCarrier | undefined = request.headers.has('traceparent')
+    ? { traceparent: request.headers.get('traceparent')! }
+    : undefined;
+  const operation = telemetry.start('http.request', carrier, requestId);
+  // The SDK boundary owns both rejection and SDK-declared failure; child spans
+  // finish before the HTTP owner projects the same finite error/diagnostic ID.
+  const binding = async <T>(
+    name: OperationName,
+    action: () => Promise<T>,
+    valid: (value: T) => boolean = () => true,
+  ): Promise<Result<T>> => {
+    const child = telemetry.start(name, { traceparent: operation.traceparent }, requestId);
+    const captured = await capture(action, 'storage_failed');
+    const result =
+      captured.ok && !valid(captured.value) ? Err(failure('storage_failed')) : captured;
+    child.finish(result);
+    return result;
+  };
+
+  const url = new URL(request.url);
+  const json = (body: unknown, status = 200) =>
+    Response.json(body, {
+      status,
+      headers: {
+        'x-request-id': requestId,
+        'x-storage-mode': env.NOTES ? 'persistent-d1' : 'volatile-sample',
+      },
+    });
+  const route = async (): Promise<Result<Response>> => {
+    if (url.pathname === '/health')
+      return Ok(json({
+        ok: true,
+        storage: env.NOTES ? 'd1' : 'volatile',
+        writeMode: env.WRITE_MODE,
+      }));
+    if (request.method !== 'GET' && env.WRITE_MODE !== 'allow')
+      return Err(failure('write_forbidden'));
+    // Authorized JSON ingress owns the body even when an optional binding is absent.
+    // Keep write-denial before any read; never wait for an unauthenticated body.
+    const text = request.method === 'POST' &&
+      ['/api/notes', '/extensions/kv', '/extensions/r2'].includes(url.pathname)
+      ? await readBodyText(request)
+      : Ok('');
+    if (!text.ok) return text;
+    let response: Response;
+    if (url.pathname === '/api/notes' && request.method === 'GET') {
+      let raw: unknown = [...volatileNotes.values()];
+      if (env.NOTES) {
+        const stored = await binding(
+          'binding.d1.read',
+          () =>
+            env
+              .NOTES!.prepare(
+                'SELECT id, text, created_at AS createdAt FROM notes ORDER BY created_at, id',
+              )
+              .all<Note>(),
+          (value) => value.success,
+        );
+        if (!stored.ok) return stored;
+        raw = stored.value.results;
+      }
+      const notes = decode(notesSchema, raw);
+      if (!notes.ok) return notes;
+      response = json(notes.value);
+    } else if (url.pathname === '/api/notes' && request.method === 'POST') {
+      const body = parseBody(text.value);
+      if (!body.ok) return body;
+      const parsed = noteInput.safeParse(body.value);
+      if (!parsed.success) return Err(failure('input_invalid'));
+      else {
+        const note: Note = {
+          id: crypto.randomUUID(),
+          text: parsed.data.text,
+          createdAt: Date.now(),
+        };
+        if (env.NOTES) {
+          const stored = await binding(
+            'binding.d1.write',
+            () =>
+              env
+                .NOTES!.prepare('INSERT INTO notes (id, text, created_at) VALUES (?, ?, ?)')
+                .bind(note.id, note.text, note.createdAt)
+                .run(),
+            (value) => value.success,
+          );
+          if (!stored.ok) return stored;
+        } else volatileNotes.set(note.id, note);
+        response = json(note, 201);
+      }
+    } else if (url.pathname.startsWith('/api/notes/') && request.method === 'DELETE') {
+      const id = url.pathname.slice('/api/notes/'.length);
+      if (!z.uuid().safeParse(id).success) return Err(failure('input_invalid'));
+      else {
+        let removed: boolean;
+        if (env.NOTES) {
+          const stored = await binding(
+            'binding.d1.write',
+            () => env.NOTES!.prepare('DELETE FROM notes WHERE id = ?').bind(id).run(),
+            (value) => value.success,
+          );
+          if (!stored.ok) return stored;
+          removed = stored.value.meta.changes > 0;
+        } else removed = volatileNotes.delete(id);
+        if (!removed) return Err(failure('resource_missing'));
+        response = new Response(null, { status: 204, headers: { 'x-request-id': requestId } });
+      }
+    } else if (url.pathname === '/extensions/kv' && env.NOTE_CACHE) {
+      if (request.method === 'POST') {
+        const body = parseBody(text.value);
+        if (!body.ok) return body;
+        const parsed = extensionInput.safeParse(body.value);
+        if (!parsed.success) return Err(failure('input_invalid'));
+        else {
+          const stored = await binding('binding.kv.write', () =>
+            env.NOTE_CACHE!.put(parsed.data.key, parsed.data.value),
+          );
+          if (!stored.ok) return stored;
+          response = json({ ok: true });
+        }
+      } else {
+        const stored = await binding('binding.kv.read', () =>
+          env.NOTE_CACHE!.get(url.searchParams.get('key') ?? ''),
+        );
+        if (!stored.ok) return stored;
+        response = json({ value: stored.value });
+      }
+    } else if (url.pathname === '/extensions/r2' && env.NOTE_EXPORTS) {
+      if (request.method === 'POST') {
+        const body = parseBody(text.value);
+        if (!body.ok) return body;
+        const parsed = extensionInput.safeParse(body.value);
+        if (!parsed.success) return Err(failure('input_invalid'));
+        else {
+          const stored = await binding('binding.r2.write', () =>
+            env.NOTE_EXPORTS!.put(parsed.data.key, parsed.data.value),
+          );
+          if (!stored.ok) return stored;
+          response = json({ ok: true });
+        }
+      } else {
+        const stored = await binding('binding.r2.read', () =>
+          env
+            .NOTE_EXPORTS!.get(url.searchParams.get('key') ?? '')
+            .then((object) => (object ? object.text() : null)),
+        );
+        if (!stored.ok) return stored;
+        response = json({ value: stored.value });
+      }
+    } else return Err(failure('resource_missing'));
+    return Ok(response);
+  };
+  const captured = await capture(route, 'storage_failed');
+  const result = captured.ok ? captured.value : captured;
+  operation.finish(result);
+  const exported = await telemetry.flush();
+  const response = result.ok
+    ? result.value
+    : json({ error: publicFailure(result.error), requestId }, errorStatus(result.error));
+  response.headers.set('traceparent', operation.traceparent);
+  response.headers.set(
+    'x-telemetry-state',
+    !telemetry.status().enabled ? 'disabled' : exported.ok ? 'accepted' : 'failed',
+  );
+  if (!result.ok) {
+    response.headers.set('x-diagnostic-id', result.error.diagnosticId);
+    response.headers.set('x-error-code', publicFailure(result.error).code);
+  }
+  await telemetry.shutdown();
+  return response;
+}
+
+function parseBody(text: string): Result<unknown> {
+  return captureSync(() => JSON.parse(text) as unknown, 'request_json_invalid');
+}
+
+async function readBodyText(request: Request): Promise<Result<string>> {
+  const opened = captureSync(() => request.body?.getReader(), 'request_json_invalid');
+  if (!opened.ok) return opened;
+  if (!opened.value) return Ok('');
+  const reader = opened.value;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const deadline = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(failure('request_json_invalid')), 3000);
+  });
+  const chunks: Uint8Array[] = [];
+  let bytes = 0;
+  let complete = false;
+  let result: Result<string> = Err(failure('request_json_invalid'));
+  const expires = performance.now() + 3000;
+  let accepting = true;
+  const collect = async (): Promise<Result<string>> => {
+    // Check wall time as well as bytes/chunks even when a producer starves timers.
+    for (let count = 0; count < 65536; count += 1) {
+      if (!accepting || performance.now() >= expires) return Err(failure('request_json_invalid'));
+      const chunk = await capture(() => reader.read(), 'request_json_invalid');
+      if (!chunk.ok) return chunk;
+      if (!accepting || performance.now() >= expires) return Err(failure('request_json_invalid'));
+      if (chunk.value.done) {
+        complete = true;
+        const data = new Uint8Array(bytes);
+        let offset = 0;
+        for (const part of chunks) { data.set(part, offset); offset += part.byteLength; }
+        return captureSync(() => new TextDecoder().decode(data), 'request_json_invalid');
+      }
+      if (!(chunk.value.value instanceof Uint8Array)) return Err(failure('request_json_invalid'));
+      bytes += chunk.value.value.byteLength;
+      if (bytes > 32768) return Err(failure('input_invalid'));
+      if (chunk.value.value.byteLength) chunks.push(chunk.value.value);
+    }
+    return Err(failure('input_invalid'));
+  };
+  // One race owns the deadline, rather than retaining a reaction per chunk.
+  const collected = await capture(() => Promise.race([collect(), deadline]), 'request_json_invalid');
+  accepting = false;
+  result = collected.ok ? collected.value : collected;
+  if (!complete) {
+    const cancelled = await capture(
+      () => Promise.race([reader.cancel(), deadline]), 'request_json_invalid',
+    );
+    if (!cancelled.ok) result = cancelled;
+  }
+  if (timer) clearTimeout(timer);
+  const released = captureSync(() => reader.releaseLock(), 'request_json_invalid');
+  return released.ok ? result : released;
+}
diff --git a/packages/status/test/runtime.test.ts b/packages/status/test/runtime.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fe58381398600248f18d2626261aa31e9bb178ef
--- /dev/null
+++ b/packages/status/test/runtime.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest';
+import { noteSchema, notesSchema } from '@independent-service/contracts';
+
+const origin = process.env.STARTER_TEST_ORIGIN;
+if (!origin) throw new Error('Use pnpm test:runtime to start real workerd before HTTP tests');
+const fetchLocal = (route: string, init?: RequestInit) => fetch(new URL(route, origin), init);
+const fetchStatus = async (route: string, init?: RequestInit) => {
+  const response = await fetchLocal(route, init);
+  await response.arrayBuffer();
+  return response.status;
+};
+
+describe('real workerd HTTP contract', () => {
+  it('serves health, validates input and completes CRUD', async () => {
+    expect(await fetchStatus('/health')).toBe(200);
+    const invalid = await fetchLocal('/api/notes', { method: 'POST', body: '{"text":""}' });
+    expect(invalid.status).toBe(400);
+    expect(await invalid.json()).toMatchObject({ error: { code: 'invalid_input' } });
+    const added = await fetchLocal('/api/notes', { method: 'POST', body: JSON.stringify({ text: 'Runtime note' }) });
+    expect(added.status).toBe(201);
+    const note = noteSchema.parse(await added.json());
+    const listed = await fetchLocal('/api/notes');
+    expect(listed.headers.get('x-storage-mode')).toBe('volatile-sample');
+    expect(notesSchema.parse(await listed.json())).toContainEqual(note);
+    expect(await fetchStatus(`/api/notes/${note.id}`, { method: 'DELETE' })).toBe(204);
+    expect(await fetchStatus(`/api/notes/${note.id}`, { method: 'DELETE' })).toBe(404);
+    expect(await fetchStatus('/api/notes/not-a-uuid', { method: 'DELETE' })).toBe(400);
+  });
+  it('enforces the normalized UTF-16 text boundary over real HTTP', async () => {
+    const text = '😀'.repeat(500);
+    const added = await fetchLocal('/api/notes', { method: 'POST', body: JSON.stringify({ text: `\uFEFF${text}\uFEFF` }) });
+    expect(added.status).toBe(201);
+    const note = noteSchema.parse(await added.json());
+    expect(note.text).toBe(text);
+    expect(await fetchStatus(`/api/notes/${note.id}`, { method: 'DELETE' })).toBe(204);
+    for (const text of ['😀'.repeat(501), `${'😀'.repeat(500)}x`]) {
+      const invalid = await fetchLocal('/api/notes', { method: 'POST', body: JSON.stringify({ text: `\uFEFF${text}\uFEFF` }) });
+      expect(invalid.status).toBe(400);
+      expect(await invalid.json()).toMatchObject({ error: { code: 'invalid_input' } });
+    }
+  });
+  it('exercises only the selected KV and R2 bindings, and refuses absent features', async () => {
+    for (const [feature, selected] of [['kv', false], ['r2', false]] as const) {
+      const response = await fetchLocal(`/extensions/${feature}`, { method: 'POST', body: JSON.stringify({ key: 'runtime-test', value: 'stored locally' }) });
+      await response.arrayBuffer();
+      expect(response.status).toBe(selected ? 200 : 404);
+      const read = await fetchLocal(`/extensions/${feature}?key=runtime-test`);
+      const body = await read.text();
+      if (read.status !== (selected ? 200 : 404))
+        console.error(`Unexpected ${feature} GET status ${read.status}: ${body}`);
+      expect(read.status).toBe(selected ? 200 : 404);
+      expect(JSON.parse(body)).toMatchObject(selected ? { value: 'stored locally' } : { error: { code: 'not_found' } });
+    }
+  });
+  it('keeps the next request usable after oversized and absent-feature JSON ingress', async () => {
+    const oversized = await fetchLocal('/api/notes', { method: 'POST', body: JSON.stringify({ text: 'x' }).padEnd(32769, ' ') });
+    expect(oversized.status).toBe(400);
+    expect(await oversized.json()).toMatchObject({ error: { code: 'invalid_input' } });
+    for (const [feature, selected] of [['kv', false], ['r2', false]] as const) {
+      const invalid = await fetchLocal(`/extensions/${feature}`, { method: 'POST', body: 'INVALID-JSON' });
+      expect(invalid.status).toBe(selected ? 400 : 404);
+      expect(await invalid.json()).toMatchObject({ error: { code: selected ? 'invalid_json' : 'not_found' } });
+      const health = await fetchLocal('/health');
+      expect(health.status).toBe(200);
+      expect(await health.json()).toMatchObject({ ok: true });
+    }
+  });
+});
diff --git a/packages/status/test/status.runtime.test.ts b/packages/status/test/status.runtime.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a283e2dd5793253874c4bfa6b44c9dee582317f
--- /dev/null
+++ b/packages/status/test/status.runtime.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+
+const origin = process.env.STARTER_TEST_ORIGIN;
+if (!origin) throw new Error('Use pnpm test:runtime to start real workerd before HTTP tests');
+
+describe('status endpoint over real workerd HTTP', () => {
+  it('returns fresh status JSON and rejects paths or methods outside its route', async () => {
+    const response = await fetch(new URL('/status?probe=ready', origin));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toBe('application/json');
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(await response.json()).toEqual({ ok: true, service: 'status' });
+
+    for (const [route, method] of [
+      ['/status/details', 'GET'],
+      ['/status', 'POST'],
+    ] as const) {
+      const unexpected = await fetch(new URL(route, origin), { method });
+      expect(unexpected.status).toBe(404);
+      expect(await unexpected.json()).toMatchObject({ error: { code: 'not_found' } });
+    }
+  });
+});
diff --git a/packages/status/test/status.test.ts b/packages/status/test/status.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..16522a8747b0f1843e4f416e23945a64f235feb4
--- /dev/null
+++ b/packages/status/test/status.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+import worker from '../src/index';
+
+const env = { WRITE_MODE: 'deny' } as Env;
+
+describe('status service HTTP routing', () => {
+  it('serves status while deployment writes stay disabled', async () => {
+    const response = await worker.fetch(new Request('https://service.invalid/status'), env);
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toBe('application/json');
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(await response.json()).toEqual({ ok: true, service: 'status' });
+
+    const write = await worker.fetch(
+      new Request('https://service.invalid/api/notes', {
+        method: 'POST',
+        body: '{"text":"blocked"}',
+      }),
+      env,
+    );
+    expect(write.status).toBe(403);
+    expect(await write.json()).toMatchObject({ error: { code: 'writes_disabled' } });
+  });
+
+  it('routes the exact GET path and preserves health', async () => {
+    const query = await worker.fetch(
+      new Request('https://service.invalid/status?probe=ready'),
+      env,
+    );
+    expect(query.status).toBe(200);
+    expect(await query.json()).toEqual({ ok: true, service: 'status' });
+
+    for (const route of ['/status/details', '/status-extra']) {
+      const response = await worker.fetch(new Request(`https://service.invalid${route}`), env);
+      expect(response.status).toBe(404);
+      expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+    }
+    const health = await worker.fetch(new Request('https://service.invalid/health'), env);
+    expect(health.status).toBe(200);
+    expect(await health.json()).toMatchObject({ ok: true });
+  });
+
+  it('does not answer another HTTP method as a successful status probe', async () => {
+    const response = await worker.fetch(
+      new Request('https://service.invalid/status', { method: 'POST' }),
+      { WRITE_MODE: 'allow' } as Env,
+    );
+    expect(response.status).toBe(404);
+    expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+  });
+});
diff --git a/packages/status/test/unit.test.ts b/packages/status/test/unit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9dbb8c8380c7d3854fefac23aa130015585bbe88
--- /dev/null
+++ b/packages/status/test/unit.test.ts
@@ -0,0 +1,242 @@
+import { describe, expect, it, vi } from 'vitest';
+import { handleNotes } from '../src/notes';
+
+describe('API validation and safe publication defaults', () => {
+  it('refuses writes in a deployment environment before touching storage', async () => {
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST',
+      body: '{"text":"blocked"}',
+    });
+    const response = await handleNotes(
+      request,
+      { WRITE_MODE: 'deny' },
+    );
+    expect(response.status).toBe(403);
+    expect(await response.json()).toMatchObject({ error: { code: 'writes_disabled' } });
+    expect(request.bodyUsed).toBe(false);
+  });
+  it.each(['kv', 'r2'])('consumes authorized absent-%s ingress without parsing it', async (feature) => {
+    const request = new Request(`https://sample.invalid/extensions/${feature}`, {
+      method: 'POST', body: 'PRIVATE-INVALID-JSON',
+    });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(404);
+    expect(request.bodyUsed).toBe(true);
+    expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+  });
+  it.each([
+    ['rejection', 500],
+    ['declared_failure', 500],
+    ['not_found', 404],
+    ['success', 204],
+  ] as const)('keeps volatile notes isolated from a D1 DELETE %s outcome', async (mode, status) => {
+    const created = await handleNotes(
+      new Request('https://sample.invalid/api/notes', {
+        method: 'POST',
+        body: JSON.stringify({ text: 'independent volatile note' }),
+      }),
+      { WRITE_MODE: 'allow' },
+    );
+    expect(created.status).toBe(201);
+    const note = (await created.json()) as { id: string; text: string; createdAt: number };
+    type DeleteResult = {
+      success: boolean;
+      error: string | undefined;
+      meta: { changes: number };
+    };
+    type DeleteStatement = { run: () => Promise<DeleteResult> };
+    type BindDelete = (id: string) => DeleteStatement;
+    const run = vi.fn<DeleteStatement['run']>(() =>
+      mode === 'rejection'
+        ? Promise.reject(new Error('PRIVATE-SQL-DO-NOT-EXPORT'))
+        : Promise.resolve({
+            success: mode !== 'declared_failure',
+            error: mode === 'declared_failure' ? 'PRIVATE-SQL-DO-NOT-EXPORT' : undefined,
+            meta: { changes: mode === 'success' ? 1 : 0 },
+          }),
+    );
+    const bind = vi.fn<BindDelete>(() => ({ run }));
+    const prepare = vi.fn<(sql: string) => { bind: BindDelete }>(() => ({ bind }));
+    const database = { prepare } as unknown as D1Database;
+    try {
+      const response = await handleNotes(
+        new Request(`https://sample.invalid/api/notes/${note.id}`, { method: 'DELETE' }),
+        { WRITE_MODE: 'allow', NOTES: database },
+      );
+      expect(prepare).toHaveBeenCalledExactlyOnceWith('DELETE FROM notes WHERE id = ?');
+      expect(bind).toHaveBeenCalledExactlyOnceWith(note.id);
+      expect(run).toHaveBeenCalledExactlyOnceWith();
+      expect(response.status).toBe(status);
+      const raw = await response.text();
+      const body = raw
+        ? (JSON.parse(raw) as { error: { code: string; diagnosticId: string } })
+        : undefined;
+      expect(raw.length === 0).toBe(status === 204);
+      expect(body?.error.code).toBe(
+        status === 500 ? 'internal_error' : status === 404 ? 'not_found' : undefined,
+      );
+      expect(body?.error.diagnosticId ?? '').toMatch(
+        status === 204 ? /^$/u : /^[a-f0-9]{32}$/u,
+      );
+      expect(response.headers.get('x-diagnostic-id')).toBe(body?.error.diagnosticId ?? null);
+      expect(response.headers.get('x-error-code')).toBe(body?.error.code ?? null);
+      expect(raw).not.toContain('PRIVATE-SQL');
+      const listed = await handleNotes(
+        new Request('https://sample.invalid/api/notes'),
+        { WRITE_MODE: 'allow' },
+      );
+      expect(listed.status).toBe(200);
+      expect(await listed.json()).toContainEqual(note);
+    } finally {
+      // Clean up this case's own note even when the preservation assertion fails.
+      await handleNotes(
+        new Request(`https://sample.invalid/api/notes/${note.id}`, { method: 'DELETE' }),
+        { WRITE_MODE: 'allow' },
+      );
+    }
+  });
+
+  it('decodes split UTF-8 ingress and bounds bytes before parsing or storage', async () => {
+    const bytes = new TextEncoder().encode(JSON.stringify({ text: '😀 split' }));
+    const stream = new ReadableStream<Uint8Array>({
+      start(controller) {
+        for (const byte of bytes) controller.enqueue(Uint8Array.of(byte));
+        controller.close();
+      },
+    });
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: stream, duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(201);
+    const note = await response.json() as { id: string; text: string };
+    expect(note.text).toBe('😀 split');
+    expect((await handleNotes(new Request(`https://sample.invalid/api/notes/${note.id}`, { method: 'DELETE' }), { WRITE_MODE: 'allow' })).status).toBe(204);
+    const maximum = await handleNotes(new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: JSON.stringify({ text: 'max-bytes' }).padEnd(32768, ' '),
+    }), { WRITE_MODE: 'allow' });
+    expect(maximum.status).toBe(201);
+    const maximumNote = await maximum.json() as { id: string };
+    expect((await handleNotes(new Request(`https://sample.invalid/api/notes/${maximumNote.id}`, { method: 'DELETE' }), { WRITE_MODE: 'allow' })).status).toBe(204);
+    const prepare = vi.fn<() => never>(() => { throw new Error('Oversized body reached storage'); });
+    const oversized = await handleNotes(new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: JSON.stringify({ text: 'PRIVATE-' }).padEnd(32769, ' '),
+    }), { WRITE_MODE: 'allow', NOTES: { prepare } as unknown as D1Database });
+    expect(prepare).not.toHaveBeenCalled();
+    expect(oversized.status).toBe(400);
+    expect(await oversized.text()).not.toContain('PRIVATE-');
+  });
+  it('normalizes an invalid stream chunk and releases its ingress lock', async () => {
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({
+        start(controller) { controller.enqueue(); controller.close(); },
+      }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { code: 'invalid_json' } });
+    expect(request.body?.locked).toBe(false);
+  });
+  it('bounds an empty-chunk producer before parsing or touching storage', async () => {
+    let cancelled = false;
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({
+        pull(controller) { controller.enqueue(new Uint8Array()); },
+        cancel() { cancelled = true; },
+      }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const prepare = vi.fn<() => never>(() => { throw new Error('Empty-chunk flood reached storage'); });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow', NOTES: { prepare } as unknown as D1Database });
+    expect(response.status).toBe(400);
+    expect(prepare).not.toHaveBeenCalled();
+    expect(cancelled).toBe(true);
+    expect(request.body?.locked).toBe(false);
+  });
+  it('bounds a stalled ingress even when its cancellation never settles', async () => {
+    const request = new Request('https://sample.invalid/extensions/kv', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({ cancel: () => new Promise<void>(() => {}) }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const started = performance.now();
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { code: 'invalid_json' } });
+    expect(performance.now() - started).toBeLessThan(4000);
+    expect(request.body?.locked).toBe(false);
+  });
+  it('returns a predictable invalid JSON error without reflecting the request body', async () => {
+    const response = await handleNotes(
+      new Request('https://sample.invalid/api/notes', { method: 'POST', body: 'PRIVATE-TEXT' }),
+      { WRITE_MODE: 'allow' },
+    );
+    expect(response.status).toBe(400);
+    expect(await response.text()).not.toContain('PRIVATE-TEXT');
+    expect(response.headers.get('x-request-id')).toMatch(/^[a-f0-9-]+$/u);
+  });
+  it.each(['rejection', 'declared_failure'])(
+    'normalizes D1 %s before HTTP projection and correlates the private-safe binding span',
+    async (mode) => {
+      const payloads: string[] = [];
+      vi.stubGlobal('fetch', (_url: string, init: RequestInit) => {
+        if (typeof init.body !== 'string') throw new Error('Expected an OTLP JSON request');
+        payloads.push(init.body);
+        return Promise.resolve(Response.json({}));
+      });
+      try {
+        const database = {
+          prepare: () => ({
+            all: () =>
+              mode === 'rejection'
+                ? Promise.reject(new Error('PRIVATE-SQL-DO-NOT-EXPORT'))
+                : Promise.resolve({ success: false, error: 'PRIVATE-SQL-DO-NOT-EXPORT' }),
+          }),
+        } as unknown as D1Database;
+        const response = await handleNotes(new Request('https://sample.invalid/api/notes'), {
+          WRITE_MODE: 'allow',
+          NOTES: database,
+          OTEL_ENDPOINT: 'http://127.0.0.1:4318',
+        });
+        const body = (await response.json()) as { error: { code: string; diagnosticId: string } };
+        // Storage failure has an unknown outcome, rather than a proven retryable network failure.
+        expect(response.status).toBe(500);
+        expect(body.error.code).toBe('internal_error');
+        expect(body.error.diagnosticId).toMatch(/^[a-f0-9]{32}$/u);
+        expect(response.headers.get('x-diagnostic-id')).toBe(body.error.diagnosticId);
+        expect(response.headers.get('x-error-code')).toBe(body.error.code);
+        const wire = payloads.join('\n');
+        expect(wire).toContain('binding.d1.read');
+        expect(wire).toContain('storage_failed');
+        expect(wire).toContain(body.error.diagnosticId);
+        expect(wire).not.toContain('PRIVATE-SQL');
+        expect(JSON.stringify(body)).not.toContain('PRIVATE-SQL');
+        const traces = JSON.parse(
+          payloads.find((payload) => payload.includes('resourceSpans'))!,
+        ) as {
+          resourceSpans: {
+            scopeSpans: {
+              spans: {
+                name: string;
+                spanId: string;
+                parentSpanId?: string;
+                attributes: { key: string; value: { stringValue: string } }[];
+              }[];
+            }[];
+          }[];
+        };
+        const spans = traces.resourceSpans.flatMap((resource) =>
+          resource.scopeSpans.flatMap((scope) => scope.spans),
+        );
+        expect(spans).toHaveLength(2);
+        const http = spans.find((span) => span.name === 'http.request')!;
+        expect(spans.find((span) => span.name === 'binding.d1.read')!.parentSpanId).toBe(
+          http.spanId,
+        );
+        for (const span of spans)
+          expect(
+            span.attributes.find((attr) => attr.key === 'app.diagnostic.id')!.value.stringValue,
+          ).toBe(body.error.diagnosticId);
+      } finally {
+        vi.unstubAllGlobals();
+      }
+    },
+  );
+});
