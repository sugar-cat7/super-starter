diff --git a/packages/status/README.md b/packages/status/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..f076da33a9f72af5d492bc2b4f2e3c7623115c67
--- /dev/null
+++ b/packages/status/README.md
@@ -0,0 +1,18 @@
+# status Worker service
+
+Generated from the API template. The Worker owns `cloudflare.config.ts` and uses the shared contracts and observability packages. Storage: Volatile sample — resets when the Worker restarts. No resource provisioning runs during setup or build.
+
+From the workspace root:
+
+```console
+pnpm dev -- status
+pnpm --filter @independent-service/status test
+pnpm --filter @independent-service/status test:runtime
+pnpm --filter @independent-service/status build
+pnpm deploy:preflight -- --target status --environment local
+pnpm --filter @independent-service/status cf --help
+```
+
+`GET /status` reports `{ "ok": true, "service": "status" }` with `Cache-Control: no-store`; only that exact GET path is a status probe. `GET /health` reports readiness; the generated `/api/notes` sample validates input and creates, lists and deletes notes. Local writes are allowed. Remote artifacts deny unauthenticated writes; a service without D1 uses volatile memory and resets on restart.
+
+For approved dev delivery, configure an existing account/token and explicitly approved domain in the sole config, plus IDs for any selected resources. Run the dev preflight, then the workspace's checked `deploy` entry with its approved health URL. Local preflight/build do not establish remote deployment or connectivity. See [Cloudflare instructions](../../docs/cloudflare.md).
diff --git a/packages/status/cloudflare.config.ts b/packages/status/cloudflare.config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c72f59f1ef5945776634ec0913b6c8281a1316b4
--- /dev/null
+++ b/packages/status/cloudflare.config.ts
@@ -0,0 +1,25 @@
+import { bindings, defineConfig } from 'cf/config';
+import * as entrypoint from './src/index.ts' with { type: 'cf-worker' };
+
+export default defineConfig(({ mode }) => {
+  const environment = mode === 'offline' ? 'local' : mode ?? 'local';
+  if (!['local', 'dev', 'production'].includes(environment)) throw new Error(`Unknown environment: ${environment}`);
+  return {
+    worker: {
+      name: 'independent-status-api-status',
+      entrypoint,
+      compatibilityDate: '2026-10-09',
+      compatibilityFlags: ['nodejs_compat'],
+      workersDev: false,
+      env: {
+        OTEL_SERVICE_NAME: bindings.text('independent-status-api-status'),
+        OTEL_VERSION: bindings.text(process.env.STARTER_OTEL_VERSION ?? 'development'),
+        OTEL_INSTANCE: bindings.text('independent-status-api'),
+        OTEL_RUN_ID: bindings.text(environment === 'local' ? process.env.STARTER_OTEL_RUN_ID ?? 'local' : environment),
+        OTEL_ENDPOINT: bindings.text(environment === 'local' ? process.env.STARTER_OTEL_ENDPOINT ?? '' : ''),
+        WRITE_MODE: bindings.text(environment === 'local' ? 'allow' : 'deny'),
+        
+      },
+    },
+  };
+});
