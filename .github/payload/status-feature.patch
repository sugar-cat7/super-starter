@@ -0,0 +1,25 @@
+import { bindings, defineConfig } from 'cf/config';
+import * as entrypoint from './src/index.ts' with { type: 'cf-worker' };
+
+export default defineConfig(({ mode }) => {
+  const environment = mode === 'offline' ? 'local' : mode ?? 'local';
+  if (!['local', 'dev', 'production'].includes(environment)) throw new Error(`Unknown environment: ${environment}`);
+  return {
+    worker: {
+      name: 'independent-status-api-status',
+      entrypoint,
+      compatibilityDate: '2026-10-09',
+      compatibilityFlags: ['nodejs_compat'],
+      workersDev: false,
+      env: {
+        OTEL_SERVICE_NAME: bindings.text('independent-status-api-status'),
+        OTEL_VERSION: bindings.text(process.env.STARTER_OTEL_VERSION ?? 'development'),
+        OTEL_INSTANCE: bindings.text('independent-status-api'),
+        OTEL_RUN_ID: bindings.text(environment === 'local' ? process.env.STARTER_OTEL_RUN_ID ?? 'local' : environment),
+        OTEL_ENDPOINT: bindings.text(environment === 'local' ? process.env.STARTER_OTEL_ENDPOINT ?? '' : ''),
+        WRITE_MODE: bindings.text(environment === 'local' ? 'allow' : 'deny'),
+        
+      },
+    },
+  };
+});
