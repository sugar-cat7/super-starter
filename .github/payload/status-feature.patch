+import { describe, expect, it } from 'vitest';
+
+const origin = process.env.STARTER_TEST_ORIGIN;
+if (!origin) throw new Error('Use pnpm test:runtime to start real workerd before HTTP tests');
+
+describe('status endpoint over real workerd HTTP', () => {
+  it('returns fresh status JSON and rejects paths or methods outside its route', async () => {
+    const response = await fetch(new URL('/status?probe=ready', origin));
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toBe('application/json');
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(await response.json()).toEqual({ ok: true, service: 'status' });
+
+    for (const [route, method] of [
+      ['/status/details', 'GET'],
+      ['/status', 'POST'],
+    ] as const) {
+      const unexpected = await fetch(new URL(route, origin), { method });
+      expect(unexpected.status).toBe(404);
+      expect(await unexpected.json()).toMatchObject({ error: { code: 'not_found' } });
+    }
+  });
+});
diff --git a/packages/status/test/status.test.ts b/packages/status/test/status.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..16522a8747b0f1843e4f416e23945a64f235feb4
--- /dev/null
+++ b/packages/status/test/status.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from 'vitest';
+import worker from '../src/index';
+
+const env = { WRITE_MODE: 'deny' } as Env;
+
+describe('status service HTTP routing', () => {
+  it('serves status while deployment writes stay disabled', async () => {
+    const response = await worker.fetch(new Request('https://service.invalid/status'), env);
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toBe('application/json');
+    expect(response.headers.get('cache-control')).toBe('no-store');
+    expect(await response.json()).toEqual({ ok: true, service: 'status' });
+
+    const write = await worker.fetch(
+      new Request('https://service.invalid/api/notes', {
+        method: 'POST',
+        body: '{"text":"blocked"}',
+      }),
+      env,
+    );
+    expect(write.status).toBe(403);
+    expect(await write.json()).toMatchObject({ error: { code: 'writes_disabled' } });
+  });
+
+  it('routes the exact GET path and preserves health', async () => {
+    const query = await worker.fetch(
+      new Request('https://service.invalid/status?probe=ready'),
+      env,
+    );
+    expect(query.status).toBe(200);
+    expect(await query.json()).toEqual({ ok: true, service: 'status' });
+
+    for (const route of ['/status/details', '/status-extra']) {
+      const response = await worker.fetch(new Request(`https://service.invalid${route}`), env);
+      expect(response.status).toBe(404);
+      expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+    }
+    const health = await worker.fetch(new Request('https://service.invalid/health'), env);
+    expect(health.status).toBe(200);
+    expect(await health.json()).toMatchObject({ ok: true });
+  });
+
+  it('does not answer another HTTP method as a successful status probe', async () => {
+    const response = await worker.fetch(
+      new Request('https://service.invalid/status', { method: 'POST' }),
+      { WRITE_MODE: 'allow' } as Env,
+    );
+    expect(response.status).toBe(404);
+    expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+  });
+});
diff --git a/packages/status/test/unit.test.ts b/packages/status/test/unit.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cbf7c9721c88994d5379ed1d62f7be5d37ccfa3d
--- /dev/null
+++ b/packages/status/test/unit.test.ts
@@ -0,0 +1,170 @@
+import { describe, expect, it, vi } from 'vitest';
+import { handleNotes } from '../src/notes';
+
+describe('API validation and safe publication defaults', () => {
+  it('refuses writes in a deployment environment before touching storage', async () => {
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST',
+      body: '{"text":"blocked"}',
+    });
+    const response = await handleNotes(
+      request,
+      { WRITE_MODE: 'deny' },
+    );
+    expect(response.status).toBe(403);
+    expect(await response.json()).toMatchObject({ error: { code: 'writes_disabled' } });
+    expect(request.bodyUsed).toBe(false);
+  });
+  it.each(['kv', 'r2'])('consumes authorized absent-%s ingress without parsing it', async (feature) => {
+    const request = new Request(`https://sample.invalid/extensions/${feature}`, {
+      method: 'POST', body: 'PRIVATE-INVALID-JSON',
+    });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(404);
+    expect(request.bodyUsed).toBe(true);
+    expect(await response.json()).toMatchObject({ error: { code: 'not_found' } });
+  });
+  it('decodes split UTF-8 ingress and bounds bytes before parsing or storage', async () => {
+    const bytes = new TextEncoder().encode(JSON.stringify({ text: '😀 split' }));
+    const stream = new ReadableStream<Uint8Array>({
+      start(controller) {
+        for (const byte of bytes) controller.enqueue(Uint8Array.of(byte));
+        controller.close();
+      },
+    });
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: stream, duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(201);
+    const note = await response.json() as { id: string; text: string };
+    expect(note.text).toBe('😀 split');
+    expect((await handleNotes(new Request(`https://sample.invalid/api/notes/${note.id}`, { method: 'DELETE' }), { WRITE_MODE: 'allow' })).status).toBe(204);
+    const maximum = await handleNotes(new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: JSON.stringify({ text: 'max-bytes' }).padEnd(32768, ' '),
+    }), { WRITE_MODE: 'allow' });
+    expect(maximum.status).toBe(201);
+    const maximumNote = await maximum.json() as { id: string };
+    expect((await handleNotes(new Request(`https://sample.invalid/api/notes/${maximumNote.id}`, { method: 'DELETE' }), { WRITE_MODE: 'allow' })).status).toBe(204);
+    const prepare = vi.fn<() => never>(() => { throw new Error('Oversized body reached storage'); });
+    const oversized = await handleNotes(new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: JSON.stringify({ text: 'PRIVATE-' }).padEnd(32769, ' '),
+    }), { WRITE_MODE: 'allow', NOTES: { prepare } as unknown as D1Database });
+    expect(prepare).not.toHaveBeenCalled();
+    expect(oversized.status).toBe(400);
+    expect(await oversized.text()).not.toContain('PRIVATE-');
+  });
+  it('normalizes an invalid stream chunk and releases its ingress lock', async () => {
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({
+        start(controller) { controller.enqueue(); controller.close(); },
+      }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { code: 'invalid_json' } });
+    expect(request.body?.locked).toBe(false);
+  });
+  it('bounds an empty-chunk producer before parsing or touching storage', async () => {
+    let cancelled = false;
+    const request = new Request('https://sample.invalid/api/notes', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({
+        pull(controller) { controller.enqueue(new Uint8Array()); },
+        cancel() { cancelled = true; },
+      }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const prepare = vi.fn<() => never>(() => { throw new Error('Empty-chunk flood reached storage'); });
+    const response = await handleNotes(request, { WRITE_MODE: 'allow', NOTES: { prepare } as unknown as D1Database });
+    expect(response.status).toBe(400);
+    expect(prepare).not.toHaveBeenCalled();
+    expect(cancelled).toBe(true);
+    expect(request.body?.locked).toBe(false);
+  });
+  it('bounds a stalled ingress even when its cancellation never settles', async () => {
+    const request = new Request('https://sample.invalid/extensions/kv', {
+      method: 'POST', body: new ReadableStream<Uint8Array>({ cancel: () => new Promise<void>(() => {}) }), duplex: 'half',
+    } as RequestInit & { duplex: 'half' });
+    const started = performance.now();
+    const response = await handleNotes(request, { WRITE_MODE: 'allow' });
+    expect(response.status).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { code: 'invalid_json' } });
+    expect(performance.now() - started).toBeLessThan(4000);
+    expect(request.body?.locked).toBe(false);
+  });
+  it('returns a predictable invalid JSON error without reflecting the request body', async () => {
+    const response = await handleNotes(
+      new Request('https://sample.invalid/api/notes', { method: 'POST', body: 'PRIVATE-TEXT' }),
+      { WRITE_MODE: 'allow' },
+    );
+    expect(response.status).toBe(400);
+    expect(await response.text()).not.toContain('PRIVATE-TEXT');
+    expect(response.headers.get('x-request-id')).toMatch(/^[a-f0-9-]+$/u);
+  });
+  it.each(['rejection', 'declared_failure'])(
+    'normalizes D1 %s before HTTP projection and correlates the private-safe binding span',
+    async (mode) => {
+      const payloads: string[] = [];
+      vi.stubGlobal('fetch', (_url: string, init: RequestInit) => {
+        if (typeof init.body !== 'string') throw new Error('Expected an OTLP JSON request');
+        payloads.push(init.body);
+        return Promise.resolve(Response.json({}));
+      });
+      try {
+        const database = {
+          prepare: () => ({
+            all: () =>
+              mode === 'rejection'
+                ? Promise.reject(new Error('PRIVATE-SQL-DO-NOT-EXPORT'))
+                : Promise.resolve({ success: false, error: 'PRIVATE-SQL-DO-NOT-EXPORT' }),
+          }),
+        } as unknown as D1Database;
+        const response = await handleNotes(new Request('https://sample.invalid/api/notes'), {
+          WRITE_MODE: 'allow',
+          NOTES: database,
+          OTEL_ENDPOINT: 'http://127.0.0.1:4318',
+        });
+        const body = (await response.json()) as { error: { code: string; diagnosticId: string } };
+        // Storage failure has an unknown outcome, rather than a proven retryable network failure.
+        expect(response.status).toBe(500);
+        expect(body.error.code).toBe('internal_error');
+        expect(body.error.diagnosticId).toMatch(/^[a-f0-9]{32}$/u);
+        expect(response.headers.get('x-diagnostic-id')).toBe(body.error.diagnosticId);
+        expect(response.headers.get('x-error-code')).toBe(body.error.code);
+        const wire = payloads.join('\n');
+        expect(wire).toContain('binding.d1.read');
+        expect(wire).toContain('storage_failed');
+        expect(wire).toContain(body.error.diagnosticId);
+        expect(wire).not.toContain('PRIVATE-SQL');
+        expect(JSON.stringify(body)).not.toContain('PRIVATE-SQL');
+        const traces = JSON.parse(
+          payloads.find((payload) => payload.includes('resourceSpans'))!,
+        ) as {
+          resourceSpans: {
+            scopeSpans: {
+              spans: {
+                name: string;
+                spanId: string;
+                parentSpanId?: string;
+                attributes: { key: string; value: { stringValue: string } }[];
+              }[];
+            }[];
+          }[];
+        };
+        const spans = traces.resourceSpans.flatMap((resource) =>
+          resource.scopeSpans.flatMap((scope) => scope.spans),
+        );
+        expect(spans).toHaveLength(2);
+        const http = spans.find((span) => span.name === 'http.request')!;
+        expect(spans.find((span) => span.name === 'binding.d1.read')!.parentSpanId).toBe(
+          http.spanId,
+        );
+        for (const span of spans)
+          expect(
+            span.attributes.find((attr) => attr.key === 'app.diagnostic.id')!.value.stringValue,
+          ).toBe(body.error.diagnosticId);
+      } finally {
+        vi.unstubAllGlobals();
+      }
+    },
+  );
+});
