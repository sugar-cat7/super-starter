{
  "name": "@starter/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {},
  "scripts": {
    "cf": "cf",
    "dev": "cf dev --mode offline",
    "preview": "node preview.ts",
    "check": "vp check .",
    "test": "node ../../tools/quality/vitest.ts --config vitest.config.ts",
    "test:runtime": "node ../../tools/cloudflare/runtime.ts",
    "build": "node ../../tools/cloudflare/build.ts",
    "typegen": "cf workers types -m local",
    "db:migrate": "node ../../tools/cloudflare/database.ts migrate",
    "db:seed": "node ../../tools/cloudflare/database.ts seed",
    "test:restart": "node test/restart.ts"
  },
  "dependencies": {
    "@starter/contracts": "workspace:*",
    "@starter/observability": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/config": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "cf": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "starter": {
    "runtime": "worker",
    "resultBoundaries": {
      "src/notes.ts:handleNotes": "HTTP ingress projects a handled Result into a platform Response."
