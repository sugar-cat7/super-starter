{
  "name": "super-starter",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "security:setup": "mise --env security install",
    "security:check": "node tools/security/scan.ts",
    "security:remediate": "node tools/security/remediate.ts",
    "check": "node tools/quality/check.ts",
    "test": "node tools/quality/gate.ts test",
    "format": "vp fmt",
    "env:setup": "node tools/dev-environment/setup.ts",
    "env:doctor": "node tools/dev-environment/doctor.ts",
    "dev": "node tools/dev-environment/dev.ts",
    "dev:web": "node tools/dev-environment/dev.ts web",
    "dev:api": "node tools/dev-environment/dev.ts api",
    "dev:desktop": "node tools/dev-environment/dev.ts desktop",
    "test:tools": "node tools/quality/vitest.ts",
    "test:lighthouse": "node tools/quality/lighthouse.ts",
    "build": "node tools/quality/gate.ts build",
    "gate:pre-pr": "node tools/quality/gate.ts pre-pr",
    "gate:full": "node tools/quality/gate.ts full",
    "app:new": "node tools/generators/cli.ts add",
    "template:init": "node tools/generators/cli.ts init",
    "template:sync": "node tools/generators/cli.ts sync --no-install",
    "template:verify": "node tools/generators/verify.ts",
    "template:faults": "node tools/quality/faults.ts",
    "template:hooks": "node tools/quality/hooks-rehearsal.ts",
    "template:lifecycle": "node tools/generators/lifecycle.ts",
    "deploy:preflight": "node tools/cloudflare/deploy.ts preflight",
    "deploy": "node tools/cloudflare/deploy.ts deploy",
    "gate:push": "node tools/quality/gate.ts push",
    "gate:ci": "node tools/quality/gate.ts ci",
    "acceptance:report": "node tools/quality/acceptance.ts",
    "errors:generate": "node tools/errors/generate.ts",
    "errors:check": "node tools/errors/generate.ts --check",
    "o11y:setup": "mise --env o11y install",
    "o11y:up": "node tools/o11y/local.ts up",
    "o11y:down": "node tools/o11y/local.ts down",
    "o11y:status": "node tools/o11y/local.ts status",
    "o11y:mcp": "node tools/o11y/mcp.ts",
    "o11y:verify": "node tools/o11y/verify.ts",
    "o11y:investigate": "node tools/o11y/investigate.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxc-parser": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
